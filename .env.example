# Store backend
NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com
NEXT_PUBLIC_VENDOR_ID=

# Razorpay — only the public key id belongs here. The key secret stays on the
# backend, which creates and verifies payments.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional: Shopify store still hosting editorial media, policies and form inboxes
# NEXT_PUBLIC_SHOPIFY_DOMAIN=your-store.myshopify.com
